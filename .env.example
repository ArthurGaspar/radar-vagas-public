# Copie para .env para rodar localmente (o .env não vai para o git).
# No GitHub Actions, cadastre os mesmos nomes em Settings → Secrets → Actions.
DISCORD_WEBHOOK_ALTA=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_PERSONALIZAR=https://discord.com/api/webhooks/...
# opcional: erros de fontes (slug que mudou, site fora do ar)
DISCORD_WEBHOOK_LOGS=
